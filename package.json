{
  "name": "sislop",
  "version": "1.0.0",
  "description": "Site p\u00fablico e portal de gest\u00e3o da banda Sislop",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "db:local": "wrangler d1 migrations apply sislop --local",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "deploy:config": "node scripts/deploy-config.js"
  },
